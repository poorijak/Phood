# คัดลอกเป็น .env.local แล้วใส่ค่า (ห้ามอัปขึ้น GitHub)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # voice ที่พูดไทยได้ (ใช้กับ TTS)
# ไม่บังคับ
CLAUDE_JUDGE_MODEL=claude-haiku-5-5
CLAUDE_CHAT_MODEL=claude-sonnet-5-5
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_v3
# Google login (สร้างที่ console.cloud.google.com > Credentials > OAuth client ID > Web application)
# ใส่ Authorized JavaScript origins: http://localhost:3000 และลิงก์ Vercel
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
