# คัดลอกเป็น .env.local แล้วใส่ค่า (ห้ามอัปขึ้น GitHub)
# แนะนำ: ElevenLabs = ฟังเสียง+พูด (STT/TTS) · Gemini = LLM · ตั้ง NEXT_PUBLIC_LOCAL_MODE=false และ TTS_PROVIDER=elevenlabs
# LLM: ใส่อย่างใดอย่างหนึ่ง (ถ้ามีทั้งคู่ ใช้ Gemini)
GEMINI_API_KEY=                 # ฟรี: aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts   # เสียงพูด (ใช้ key เดียวกัน · โควตาฟรีรายวันน้อย จึงมี scripts/gen-audio.mjs สร้างไฟล์ล่วงหน้า)
GEMINI_TTS_VOICE=Kore
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=            # ไม่บังคับ (ค่าเริ่มต้นเป็นเสียงสำเร็จรูป)
# ไม่บังคับ
CLAUDE_JUDGE_MODEL=claude-haiku-5-5
CLAUDE_CHAT_MODEL=claude-sonnet-5-5
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_v3
# Google login (สร้างที่ console.cloud.google.com > Credentials > OAuth client ID > Web application)
# ใส่ Authorized JavaScript origins: http://localhost:3000 และลิงก์ Vercel
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
TTS_PROVIDER=elevenlabs        # elevenlabs | gemini | browser
